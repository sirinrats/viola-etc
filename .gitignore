# Large data folders — distributed via S3 (or symlinked locally for dev)
stellar_models/*.csv
molecular_templates/*.csv
sky_models/*.fits

# Python / OS
__pycache__/
*.py[cod]
*$py.class
.DS_Store
.cache/
.ipynb_checkpoints/

# Streamlit secrets (NEVER commit)
.streamlit/secrets.toml

# Virtual environments
.venv/
venv/
env/

# Office lock files
~$*

# Editor
.vscode/
.idea/

# Technical documentation — only the PDF ships to GitHub
# This covers viola_etc.tex, build artifacts (.aux, .log, ...), the bib/ folder,
# and figures/.  Only *.pdf at the top level of the folder is tracked.
VIOLA_ETC_Technical_Documentation/*
!VIOLA_ETC_Technical_Documentation/
!VIOLA_ETC_Technical_Documentation/*.pdf
# Also explicitly cover the .bib files and BibTeX build artifacts
VIOLA_ETC_Technical_Documentation/bib/
*.bbl
*.blg
